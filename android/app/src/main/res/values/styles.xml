<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. 状态栏/导航栏底色与主界面背景保持一致 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/cunzhi_accent</item>
        <item name="colorPrimaryDark">@color/cunzhi_bg</item>
        <item name="colorAccent">@color/cunzhi_accent</item>
        <item name="android:statusBarColor">@color/cunzhi_bg</item>
        <item name="android:navigationBarColor">@color/cunzhi_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/cunzhi_bg</item>
        <item name="android:navigationBarColor">@color/cunzhi_bg</item>
    </style>

    <!-- 冷启动窗口：底色 = 主界面底色，图标 = 原 logo；
         全面屏/刘海屏下状态栏绘制在 cutout 区域，颜色与 splash 完全连成一片 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/cunzhi_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/cunzhi_bg</item>
        <item name="android:navigationBarColor">@color/cunzhi_bg</item>
    </style>
</resources>
